{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "$code.matches(/^[A-HJ-NP-Z2-9]{5}$/)",
        ".write": "$code.matches(/^[A-HJ-NP-Z2-9]{5}$/)",
        ".validate": "newData.hasChildren(['game', 'created']) && newData.child('game').isString() && newData.child('created').isNumber()"
      }
    }
  }
}
